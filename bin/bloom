#!/usr/bin/env bash
# bloom: command-line entry point for the Bloom shell.
set -euo pipefail

BLOOM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
QS_LINK="$CONFIG_HOME/quickshell/bloom"
UNIT_DIR="$CONFIG_HOME/systemd/user"
UNITS=(bloom-shell.service bloom-shell-failed.service)

die() {
	printf 'bloom: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<'EOF'
Usage: bloom <command> [args]

  ipc <target> <function> [args...]  Call a shell IPC function; fails if the shell isn't running
  doctor [--json]                    Read-only health report (exit 0 healthy, 1 degraded, 2 failed)
  support [--preview] [--output FILE] Write a private, redacted support bundle (never uploaded)
  settings                           Open Bloom Settings
  install [--dry-run] [--no-deps] [--restart] Install Bloom with backups and a manifest
  update [--rollback] [--no-deps]      Update a clean checkout or restore the previous revision
  uninstall [--remove-deps]           Restore files recorded by the installer
  recover [--resume|--restore-originals] Inspect or recover an interrupted lifecycle operation
  dev install                        Link this checkout into ~/.config (shell config + systemd units)
  dev uninstall                      Remove the links made by dev install
  dev status                         Show what dev install linked
  dev soak <surface>                 Cycle a visual surface and check restarts, logs and memory
  version                            Print the Bloom version
  help                               Show this help
EOF
}

cmd_version() {
	local v
	v="$(cat "$BLOOM_ROOT/VERSION")"
	if git -C "$BLOOM_ROOT" rev-parse --short HEAD >/dev/null 2>&1; then
		printf '%s (%s)\n' "$v" "$(git -C "$BLOOM_ROOT" rev-parse --short HEAD)"
	else
		printf '%s\n' "$v"
	fi
}

# Pending is an explicit receipt; CLI success waits for the disk commit.
settings_reply() {
	local out="$1" ticket result state
	if [[ "$out" == pending:* ]]; then
		ticket="${out#pending:}"
		for _ in {1..150}; do
			result="$(timeout 2 qs -c bloom ipc call settings result "$ticket")" || { printf 'Settings status unavailable; reload before retrying\n' >&2; return 1; }
			state="$(jq -r '.state' <<<"$result")"
			case "$state" in
				succeeded) printf 'ok\n'; return 0 ;;
				failed|unknown) jq -r '.error' <<<"$result"; return 1 ;;
			esac
			sleep 0.02
		done
		printf 'Settings commit not confirmed; reload before retrying\n' >&2
		return 1
	fi
	printf '%s\n' "$out"
}

cmd_ipc() {
	[[ $# -ge 2 ]] || die "usage: bloom ipc <target> <function> [args...]"
	if [[ "$1" == dock && "$2" == reorder && $# -eq 3 && "$3" == \[* ]]; then
		set -- "$1" "$2" "$(jq -n --arg value "$3" '$value')"
	fi
	if [[ "$1" == settings && "$2" == set ]]; then
		[[ $# -eq 4 ]] || die "usage: bloom ipc settings set <key> <value>"
		# The shell answers "ok" or the reason it refused; turn a refusal into
		# a failing exit so scripts can rely on it.
		local out
		# qs ipc call expands JSON arrays into multiple positional arguments.
		# Wrap one as a JSON string so the shell receives it as one value.
		if [[ "${4:-}" == \[* ]]; then
			set -- "$1" "$2" "$3" "$(jq -n --arg value "$4" '$value')"
		fi
		out="$(qs -c bloom ipc call "$@")" || exit $?
		if [[ "$out" == pending:* ]]; then settings_reply "$out"; return $?; fi
		printf '%s\n' "$out"
		[[ "$out" == ok ]] || exit 1
		return 0
	fi
	local result
	result="$(qs -c bloom ipc call "$@")" || return $?
	settings_reply "$result"
}

# Pairs of "target link" that dev install manages.
dev_links() {
	printf '%s %s\n' "$BLOOM_ROOT/shell" "$QS_LINK"
	local u
	for u in "${UNITS[@]}"; do
		printf '%s %s\n' "$BLOOM_ROOT/systemd/$u" "$UNIT_DIR/$u"
	done
}

dev_install() {
	local target link
	# Check every link first so a refusal leaves nothing half-installed.
	while read -r target link; do
		if [[ -L "$link" ]]; then
			[[ "$(readlink "$link")" == "$target" ]] || die "$link already links to $(readlink "$link"); remove it first"
		elif [[ -e "$link" ]]; then
			die "$link already exists; move it away first"
		fi
	done < <(dev_links)
	while read -r target link; do
		[[ -L "$link" ]] && continue
		mkdir -p "$(dirname "$link")"
		ln -s "$target" "$link"
		printf 'linked %s -> %s\n' "$link" "$target"
	done < <(dev_links)
	systemctl --user daemon-reload
	echo "Not enabled. Start with: systemctl --user start bloom-shell"
}

dev_uninstall() {
	systemctl --user stop bloom-shell.service >/dev/null 2>&1 || true
	local target link
	while read -r target link; do
		if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
			rm "$link"
			printf 'removed %s\n' "$link"
		elif [[ -e "$link" || -L "$link" ]]; then
			printf 'left %s (not a bloom link)\n' "$link"
		fi
	done < <(dev_links)
	systemctl --user daemon-reload
}

dev_status() {
	local target link
	while read -r target link; do
		if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
			printf 'linked     %s\n' "$link"
		elif [[ -e "$link" || -L "$link" ]]; then
			printf 'foreign    %s\n' "$link"
		else
			printf 'missing    %s\n' "$link"
		fi
	done < <(dev_links)
}

cmd_dev() {
	case "${1:-}" in
	install) dev_install ;;
	uninstall) dev_uninstall ;;
	status) dev_status ;;
	soak) shift; exec python3 "$BLOOM_ROOT/tools/bloom-soak.py" "$@" ;;
	*) die "usage: bloom dev install|uninstall|status|soak <surface>" ;;
	esac
}

cmd_doctor() {
	# Read-only and time-bounded; works when the shell or session is down.
	if ! command -v python3 >/dev/null; then
		echo "bloom doctor needs python3; service state:" >&2
		timeout 3 systemctl --user status bloom-shell.service --no-pager --lines 20 2>&1 || true
		exit 2
	fi
	local status=0
	python3 "$BLOOM_ROOT/tools/bloom-doctor.py" "$@" || status=$?
	case " $* " in
	*" --json "* | *" --support "*) ;;
	*)
		printf '\nRecent shell log (not included in support bundles):\n'
		timeout 3 journalctl --user -u bloom-shell.service -n 30 --no-pager 2>&1 || true
		;;
	esac
	return "$status"
}

main() {
	local cmd="${1:-}"
	shift || true
	case "$cmd" in
	ipc) cmd_ipc "$@" ;;
	doctor) cmd_doctor "$@" ;;
	support) cmd_doctor --support "$@" ;;
	settings) exec qs --no-duplicate -p "$BLOOM_ROOT/shell/settings-app.qml" ;;
	install | update | uninstall | recover) exec python3 "$BLOOM_ROOT/tools/bloom-lifecycle.py" "$cmd" "$@" ;;
	dev) cmd_dev "$@" ;;
	version) cmd_version ;;
	help | -h | --help) usage ;;
	"") usage >&2; exit 1 ;;
	*) die "unknown command: $cmd (see: bloom help)" ;;
	esac
}

main "$@"
