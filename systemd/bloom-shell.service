[Unit]
Description=Bloom shell (Quickshell)
Documentation=https://github.com/DhanushSantosh/bloom-dots
# Stops with the session where graphical-session.target is used (e.g. uwsm).
# On a plain Hyprland session the shell is started by Hyprland (phase 8).
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=bloom-shell-failed.service

[Service]
Type=simple
# Bloom runs only in a live Hyprland session: not under another desktop that
# also uses graphical-session.target, and not with a dead Hyprland's leftover
# environment. A skipped condition is not a crash: preserve retries for real
# failures and wait for the next login.
ExecCondition=/bin/sh -c 'case "$$WAYLAND_DISPLAY" in "") exit 1;; /*) test -S "$$WAYLAND_DISPLAY";; *) test -S "%t/$$WAYLAND_DISPLAY";; esac || exit 1; case "$$HYPRLAND_INSTANCE_SIGNATURE" in "" | */* | .*) exit 1;; esac; test -S "%t/hypr/$$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock"'
ExecStart=/usr/bin/qs --no-color -c bloom
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
