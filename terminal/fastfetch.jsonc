// Bloom's fastfetch, shown once in each new kitty window. The logo comes from
// bloom.bash (--logo), so this file never needs the checkout's path.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 18,
    "height": 9,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "white" },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "Bloom for Linux" },
    "break",
    { "type": "os", "key": "System", "format": "{name}" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "wm", "key": "Desktop", "format": "{pretty-name} with Bloom" },
    { "type": "shell", "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "packages", "key": "Packages" },
    "break",
    { "type": "cpu", "key": "CPU", "format": "{name}" },
    { "type": "gpu", "key": "GPU", "format": "{name}" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "battery", "key": "Battery" },
    { "type": "uptime", "key": "Uptime" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
