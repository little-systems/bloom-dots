// Bloom's fastfetch for narrow or short windows (bloom.bash picks it): no
// logo, and only what fits 40 columns by 8 lines (10 with the prompt).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "white" },
    "key": { "width": 10 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "Bloom for Linux" },
    "break",
    { "type": "os", "key": "System", "format": "{name}" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "wm", "key": "Desktop", "format": "{pretty-name}" },
    { "type": "memory", "key": "Memory", "format": "{used} / {total}" },
    { "type": "uptime", "key": "Uptime" }
  ]
}
